{
  "name": "orbit-test",
  "version": "1.0.0",
  "private": true,
  "description": "A small TypeScript customer application using the synthetic OrbitChat v1 SDK.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orbitchat/sdk": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3"
  }
}
